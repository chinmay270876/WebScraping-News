# sqlite (default, no server required) or mysql
DB_ENGINE=sqlite
SQLITE_PATH=news.db

# MySQL — used only when DB_ENGINE=mysql
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=news

# Optional crawl limits
MAX_ARTICLES=25
MAX_PAGES=40
MAX_DEPTH=2
REQUEST_DELAY_MIN=1.5
REQUEST_DELAY_MAX=3.0

# Newsletter (leave blank to print the digest instead of sending)
EMAIL_USER=
EMAIL_PASSWORD=
RECIPIENT_EMAIL=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465

# RAG knowledge base
RAG_ENABLED=true
RAG_VECTOR_DB_PATH=./data/chroma
RAG_COLLECTION_NAME=news_articles
RAG_EMBEDDING_MODEL=all-MiniLM-L6-v2
RAG_CHUNK_SIZE=800
RAG_CHUNK_OVERLAP=100
RAG_TOP_K=5

# LLM question answering (not used during crawl or ingestion)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
